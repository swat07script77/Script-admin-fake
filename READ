                .center([35, 48])
                .scale(width / 2.3)
                .translate([width / 2, height / 2]);

            pathGenerator = d3.geoPath().projection(projection);

            zoom = d3.zoom()
                .scaleExtent([0.8, 18])
                .on('zoom', (event) => {
                    mapGroup.attr('transform', event.transform);
                    hideContextMenu();
                });

            svg.call(zoom);
            mapGroup = svg.append('g').attr('id', 'map-group');

            try {
                // Fetch world topological map data
                const response = await fetch('https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json');
                const worldData = await response.json();
                const countries = topojson.feature(worldData, worldData.objects.countries).features;

                countries.forEach((c) => {
                    const cid = parseInt(c.id);
                    countryFeatureMap[cid] = c;
                    countryArmies[cid] = Math.floor(Math.random() * 40) + 60; // 60-100 army force
                    countryBlocColors[cid] = COLOR_PALETTE[cid % COLOR_PALETTE.length];
                    countryOccupation[cid] = 0; // 0% initial occupation
                });

                // Specific default regional colors matching Ukraine/Russia/Turkey area
                countryBlocColors[804] = "#82c99b"; // Ukraine green
                countryBlocColors[643] = "#d8beaa"; // Russia beige
                countryBlocColors[792] = "#a8e0d0"; // Turkey mint
                countryBlocColors[760] = "#b5dfa3"; // Syria light green
                countryBlocColors[368] = "#a0d1b1"; // Iraq sage
                countryBlocColors[112] = "#e2b8d0"; // Belarus pink

                // Render Base Country Polygons
                countryPaths = mapGroup.append('g')
                    .attr('id', 'countries-layer')
                    .selectAll('path')
                    .data(countries)
                    .enter()
                    .append('path')
                    .attr('class', 'country')
                    .attr('id', d => `country-${d.id}`)
                    .attr('d', pathGenerator)
                    .attr('fill', d => countryBlocColors[parseInt(d.id)] || '#1e293b')
                    .on('mouseover', handleCountryHover)
                    .on('mouseout', handleCountryOut)
                    .on('click', handleCountryClick);

                // Layer for Progressive Occupation Overlay (Sector Conquest)
                occupationLayer = mapGroup.append('g').attr('id', 'occupation-layer');

                // Render Text Labels for Countries
                mapGroup.append('g')
                    .attr('id', 'country-labels-layer')
                    .selectAll('text')
                    .data(countries)
                    .enter()
                    .append('text')
                    .attr('class', 'country-label')
                    .attr('id', d => `country-label-${d.id}`)
                    .attr('x', d => {
                        const centroid = pathGenerator.centroid(d);
                        return isNaN(centroid[0]) ? 0 : centroid[0];
                    })
                    .attr('y', d => {
                        const centroid = pathGenerator.centroid(d);
                        return isNaN(centroid[1]) ? 0 : centroid[1];
                    })
                    .text(d => getCountryDisplayName(parseInt(d.id)));

                // Frontline Units & Bullets Layer
                frontlineGroup = mapGroup.append('g').attr('id', 'frontline-layer');
                bulletsGroup = mapGroup.append('g').attr('id', 'bullets-layer');

                // Hide loader once rendered
                document.getElementById('map-loader').classList.add('hidden');

                svg.on('click', (event) => {
                    if (event.target.tagName === 'svg' || event.target.id === 'map-container') {
                        hideContextMenu();
                        cancelPendingSelection();
                    }
                });

                // Default war setup between Ukraine and Russia
                addWar(643, 804, 'mutual');

            } catch (err) {
                console.error("Failed to load map data:", err);
                document.getElementById('map-loader').innerHTML = `<span class="text-xs text-red-400 font-mono">Erro ao carregar mapa. Verifique a conexão.</span>`;
            }
        }

        function handleCountryHover(event, d) {
            const countryId = parseInt(d.id);
            const army = countryArmies[countryId] || 0;
            const name = getCountryDisplayName(countryId);

            const tooltip = d3.select('#map-tooltip');
            tooltip.style('display', 'block')
                .style('left', (event.pageX + 12) + 'px')
                .style('top', (event.pageY - 15) + 'px');

            d3.select('#tooltip-title').text(name);
            d3.select('#tooltip-bloc').text(`Código ISO: #${countryId}`);
            d3.select('#tooltip-army').html(`<i class="fa-solid fa-person-military-rifle"></i> Exército: <strong>${army}</strong>`);
        }

        function handleCountryOut() {
            d3.select('#map-tooltip').style('display', 'none');
        }

        function handleCountryClick(event, d) {
            event.stopPropagation();
            const clickedId = parseInt(d.id);

            if (pendingSelectionMode && selectedSourceCountry) {
                if (clickedId === selectedSourceCountry) {
                    cancelPendingSelection();
                    hideContextMenu();
                    return;
                }

                addWar(selectedSourceCountry, clickedId, pendingSelectionMode);
                cancelPendingSelection();
                hideContextMenu();
                return;
            }

            selectedSourceCountry = clickedId;
            updateTopHUDCard(clickedId);
            showContextMenuAt(event.pageX, event.pageY, clickedId);
        }

        function updateTopHUDCard(countryId) {
            const name = getCountryDisplayName(countryId);
            const force = countryArmies[countryId] || 0;
            const meta = COUNTRY_META[countryId];

            document.getElementById('hud-country-name').innerText = name;
            document.getElementById('hud-country-force').innerText = force;

            const flagContainer = document.getElementById('hud-flag');
            flagContainer.innerHTML = '';

            if (meta && meta.flagColors) {
                meta.flagColors.forEach(col => {
                    const stripe = document.createElement('div');
                    stripe.className = 'flex-1 w-full';
                    stripe.style.backgroundColor = col;
                    flagContainer.appendChild(stripe);
                });
            } else {
                flagContainer.style.backgroundColor = countryBlocColors[countryId] || '#00f0ff';
            }

            document.getElementById('selected-country-hud').classList.remove('hidden');
        }

        function reinforceSelectedFromHUD() {
            if (selectedSourceCountry) {
                reinforceCountryArmy(30);
            }
        }

        function showContextMenuAt(x, y, countryId) {
            const menu = document.getElementById('country-context-menu');
            const name = getCountryDisplayName(countryId);
            const army = countryArmies[countryId] || 0;

            document.getElementById('ctx-country-name').innerText = name;
            document.getElementById('ctx-country-army').innerText = `⚔️ ${army}`;
            document.getElementById('ctx-bloc-dot').style.backgroundColor = countryBlocColors[countryId] || '#ffffff';

            menu.style.left = `${Math.min(x, window.innerWidth - 170)}px`;
            menu.style.top = `${Math.min(y + 10, window.innerHeight - 200)}px`;
            menu.classList.remove('hidden');

            setTimeout(() => {
                menu.classList.remove('opacity-0', 'scale-95');
                menu.classList.add('opacity-100', 'scale-100');
            }, 10);
        }

        function hideContextMenu() {
            const menu = document.getElementById('country-context-menu');
            menu.classList.remove('opacity-100', 'scale-100');
            menu.classList.add('opacity-0', 'scale-95');
            setTimeout(() => menu.classList.add('hidden'), 150);
        }

        function initiateAttackSelection(mode) {
            pendingSelectionMode = mode;
            hideContextMenu();

            const attackIndicator = document.getElementById('attack-mode-indicator');
            const attackText = document.getElementById('attack-mode-text');
            attackIndicator.classList.remove('hidden');

            const sourceName = getCountryDisplayName(selectedSourceCountry);
            attackText.innerText = `${sourceName} -> CLIQUE NO INIMIGO PARA INVADIR`;
        }

        function cancelPendingSelection() {
            pendingSelectionMode = null;
            document.getElementById('attack-mode-indicator').classList.add('hidden');
        }

        function reinforceCountryArmy(amount = 50) {
            if (!selectedSourceCountry) return;
            countryArmies[selectedSourceCountry] = (countryArmies[selectedSourceCountry] || 0) + amount;
            const name = getCountryDisplayName(selectedSourceCountry);
            updateTickerLog(`[REFORÇO] ${name} reforçou com +${amount} exército! (Total: ${countryArmies[selectedSourceCountry]})`);
            updateTopHUDCard(selectedSourceCountry);
            document.getElementById('ctx-country-army').innerText = `⚔️ ${countryArmies[selectedSourceCountry]}`;
        }

        function cycleCountryBloc() {
            if (!selectedSourceCountry) return;
            const nextColor = COLOR_PALETTE[Math.floor(Math.random() * COLOR_PALETTE.length)];
            countryBlocColors[selectedSourceCountry] = nextColor;

            d3.select(`#country-${selectedSourceCountry}`)
                .transition().duration(250)
                .attr('fill', nextColor);

            document.getElementById('ctx-bloc-dot').style.backgroundColor = nextColor;
            updateTickerLog(`[COR REALTERADA] ${getCountryDisplayName(selectedSourceCountry)} trocou de cor.`);
        }

        function addWar(attackerId, defenderId, mode) {
            if (attackerId === defenderId) return;

            const existing = activeWars.find(w => 
                (w.attackerId === attackerId && w.defenderId === defenderId) ||
                (w.attackerId === defenderId && w.defenderId === attackerId)
            );

            if (!existing) {
                activeWars.push({
                    id: `${attackerId}-${defenderId}`,
                    attackerId,
                    defenderId,
                    mode,
                    attackerAdvance: 0.15,
                    isRetreating: false
                });
                updateWarCounters();

                const aName = getCountryDisplayName(attackerId);
                const dName = getCountryDisplayName(defenderId);
                updateTickerLog(`[LINHA DE CONFRONTO] Tropas de ${aName} e ${dName} entraram em batalha!`);
            }
        }

        function stopAllWars() {
            activeWars = [];
            frontlineGroup.selectAll('*').remove();
            bulletsGroup.selectAll('*').remove();
            occupationLayer.selectAll('*').remove();
            updateWarCounters();
            updateTickerLog(`[CESSAR-FOGO GLOBAL] Fim das hostilidades e linhas de combate.`);
        }

        function updateWarCounters() {
            document.getElementById('active-wars-count').innerText = activeWars.length;
        }

        function cycleSimulationSpeed() {
            if (simulationSpeedMultiplier === 1) simulationSpeedMultiplier = 2;
            else if (simulationSpeedMultiplier === 2) simulationSpeedMultiplier = 4;
            else if (simulationSpeedMultiplier === 4) simulationSpeedMultiplier = 8;
            else simulationSpeedMultiplier = 1;

            document.getElementById('speed-label').innerText = `${simulationSpeedMultiplier}x`;
            startWarSimulationLoop();
        }

        function toggleResistanceMode() {
            resistanceMode = !resistanceMode;
            const label = document.getElementById('resistance-label');
            label.innerText = resistanceMode ? "Sim" : "Não";
            label.className = resistanceMode ? "font-bold text-emerald-400" : "font-bold text-red-400";
            updateTickerLog(`[RESISTÊNCIA] ${resistanceMode ? "Ativada: Países convocam reforços de emergência." : "Desativada: Avanço sem contra-ataque."}`);
        }

        function startWarSimulationLoop() {
            if (warSimulationInterval) clearInterval(warSimulationInterval);
            const tickRate = Math.max(180, Math.floor(750 / simulationSpeedMultiplier));

            warSimulationInterval = setInterval(() => {
                runFrontlineCombatTick();
            }, tickRate);
        }

        // MAIN WARFARE TICK WITH RETREAT, FLANKING, AND PROGRESSIVE OCCUPATION
        function runFrontlineCombatTick() {
            if (activeWars.length === 0) {
                frontlineGroup.selectAll('*').remove();
                bulletsGroup.selectAll('*').remove();
                return;
            }

            for (let i = activeWars.length - 1; i >= 0; i--) {
                const war = activeWars[i];
                const attId = war.attackerId;
                const defId = war.defenderId;

                const attFeature = countryFeatureMap[attId];
                const defFeature = countryFeatureMap[defId];

                if (!attFeature || !defFeature) continue;

                let attArmy = countryArmies[attId] || 0;
                let defArmy = countryArmies[defId] || 0;

                const c1 = pathGenerator.centroid(attFeature);
                const c2 = pathGenerator.centroid(defFeature);

                if (isNaN(c1[0]) || isNaN(c2[0])) continue;

                const attUnitCount = Math.max(0, Math.min(14, Math.floor(attArmy / 10)));
                const defUnitCount = Math.max(0, Math.min(14, Math.floor(defArmy / 10)));

                // --- 1. TACTICAL RETREAT ("SISTEMA DE RECUAR") ---
                let isRetreating = false;
                if (attUnitCount > 0 && defUnitCount > 0 && attUnitCount >= defUnitCount * 2) {
                    isRetreating = true;
                    war.isRetreating = true;
                } else {
                    war.isRetreating = false;
                }

                // --- 2. ADVANCE & FLANKING SPEED LOGIC ---
                let advanceRate = 0.04;

                if (defUnitCount === 0) {
                    // Flanking unassigned gap: advance faster into empty territory!
                    advanceRate = 0.09;
                } else if (isRetreating) {
                    // Tactical retreat slows enemy penetration
                    advanceRate = 0.02;
                }

                if (attUnitCount > defUnitCount) {
                    war.attackerAdvance += advanceRate;
                } else if (defUnitCount > attUnitCount && resistanceMode) {
                    war.attackerAdvance -= advanceRate * 0.8;
                }

                war.attackerAdvance = Math.max(0.1, Math.min(0.9, war.attackerAdvance));

                // Update Sector-by-Sector Occupation Overlay
                renderTerritoryOccupation(defId, war.attackerAdvance, countryBlocColors[attId]);

                // Render micro flag units on frontline
                renderFrontlineUnits(war, c1, c2, attUnitCount, defUnitCount);

                // --- 3. COMBAT INTERACTION & CASUALTIES ---
                if (attUnitCount > 0 && defUnitCount > 0) {
                    fireFrontlineBullets(c1, c2, war.attackerAdvance);

                    const attDamage = isRetreating ? 1 : Math.floor(Math.random() * 3) + 2;
                    const defDamage = Math.floor(Math.random() * 4) + 2;

                    countryArmies[defId] = Math.max(0, defArmy - defDamage);

                    if (resistanceMode || war.mode === 'mutual') {
                        countryArmies[attId] = Math.max(0, attArmy - attDamage);
                    }

                    playGunfireSound();
                }

                // --- 4. REINFORCEMENTS ("CHEGAR MAIS EXÉRCITO") ---
                if (resistanceMode && countryArmies[defId] < 20 && Math.random() < 0.35) {
                    const reinforcementAmount = Math.floor(Math.random() * 15) + 15;
                    countryArmies[defId] += reinforcementAmount;
                    const name = getCountryDisplayName(defId);
                    updateTickerLog(`[REFORÇOS] ${name} mobilizou +${reinforcementAmount} tropas para deter o avanço!`);
                }

                // --- 5. FULL CONQUEST (100% TERRITORY CAPTURED) ---
                if (war.attackerAdvance >= 0.88 && countryArmies[defId] <= 10) {
                    conquerCountry(attId, defId);
                    activeWars.splice(i, 1);
                    continue;
                }

                if (selectedSourceCountry === attId || selectedSourceCountry === defId) {
                    updateTopHUDCard(selectedSourceCountry);
                }
            }
        }

        // PROGRESSIVE SECTOR OCCUPATION OVERLAY
        function renderTerritoryOccupation(countryId, occupationRatio, attackerColor) {
            const feature = countryFeatureMap[countryId];
            if (!feature) return;

            let occPath = occupationLayer.select(`#occ-zone-${countryId}`);

            if (occupationRatio <= 0.15) {
                if (!occPath.empty()) occPath.remove();
                return;
            }

            if (occPath.empty()) {
                occPath = occupationLayer.append('path')
                    .attr('id', `occ-zone-${countryId}`)
                    .attr('class', 'occupation-zone')
                    .attr('pointer-events', 'none')
                    .attr('opacity', 0.6);
            }

            // Draw translucent pulsing occupation fill overlay
            occPath.attr('d', pathGenerator(feature))
                .attr('fill', attackerColor)
                .attr('stroke', '#ff2a5f')
                .attr('stroke-width', '1px')
                .attr('stroke-dasharray', '2,2');
        }

        // RENDER FRONTLINE FLAG BADGES
        function renderFrontlineUnits(war, c1, c2, attCount, defCount) {
            const warGroupId = `war-group-${war.id}`;
            let warGroup = frontlineGroup.select(`#${warGroupId}`);

            if (warGroup.empty()) {
                warGroup = frontlineGroup.append('g').attr('id', warGroupId);
            }

            warGroup.selectAll('*').remove();

            const dx = c2[0] - c1[0];
            const dy = c2[1] - c1[1];
            const dist = Math.sqrt(dx * dx + dy * dy);

            const perpX = -dy / dist;
            const perpY = dx / dist;

            const advanceFactor = war.attackerAdvance;
            const attFrontX = c1[0] + dx * advanceFactor;
            const attFrontY = c1[1] + dy * advanceFactor;

            const retreatOffset = war.isRetreating ? 0.12 : 0.07;
            const defFrontX = c1[0] + dx * (advanceFactor + retreatOffset);
            const defFrontY = c1[1] + dy * (advanceFactor + retreatOffset);

            const attMeta = COUNTRY_META[war.attackerId];
            const defMeta = COUNTRY_META[war.defenderId];

            const attColor = countryBlocColors[war.attackerId] || "#ff2a5f";
            const defColor = countryBlocColors[war.defenderId] || "#00f0ff";

            // Attacker Frontline Units
            const spacing = 5.2;
            const attStartOffset = -((attCount - 1) * spacing) / 2;

            for (let i = 0; i < attCount; i++) {
                const offset = attStartOffset + (i * spacing);
                const ux = attFrontX + perpX * offset;
                const uy = attFrontY + perpY * offset;

                drawMicroFlagUnit(warGroup, ux, uy, attMeta, attColor);
            }

            // Defender Frontline Units
            const defStartOffset = -((defCount - 1) * spacing) / 2;

            for (let i = 0; i < defCount; i++) {
                const offset = defStartOffset + (i * spacing);
                const ux = defFrontX + perpX * offset;
                const uy = defFrontY + perpY * offset;

                drawMicroFlagUnit(warGroup, ux, uy, defMeta, defColor);
            }
        }

        // DRAW FLAG RECTANGLE TOKENS
        function drawMicroFlagUnit(group, x, y, meta, fallbackColor) {
            const unit = group.append('g')
                .attr('class', 'frontline-unit')
                .attr('transform', `translate(${x - 2.5}, ${y - 1.5})`);

            unit.append('rect')
                .attr('width', 5)
                .attr('height', 3.2)
                .attr('rx', 0.5)
                .attr('fill', '#1a202c');

            if (meta && meta.flagColors && meta.flagColors.length >= 2) {
                const h = 3.2 / meta.flagColors.length;
                meta.flagColors.forEach((col, idx) => {
                    unit.append('rect')
                        .attr('x', 0)
                        .attr('y', idx * h)
                        .attr('width', 5)
                        .attr('height', h)
                        .attr('fill', col);
                });
            } else {
                unit.append('rect')
                    .attr('width', 5)
                    .attr('height', 3.2)
                    .attr('fill', fallbackColor);
            }

            unit.append('rect')
                .attr('width', 5)
                .attr('height', 3.2)
                .attr('rx', 0.5)
                .attr('fill', 'none')
                .attr('stroke', '#000000')
                .attr('stroke-width', '0.4px');
        }

        function fireFrontlineBullets(c1, c2, advanceFactor) {
            const dx = c2[0] - c1[0];
            const dy = c2[1] - c1[1];

            const startX = c1[0] + dx * advanceFactor;
            const startY = c1[1] + dy * advanceFactor;

            const endX = c1[0] + dx * (advanceFactor + 0.07);
            const endY = c1[1] + dy * (advanceFactor + 0.07);

            const bullet = bulletsGroup.append('line')
                .attr('class', 'bullet-line')
                .attr('x1', startX + (Math.random() - 0.5) * 8)
                .attr('y1', startY + (Math.random() - 0.5) * 8)
                .attr('x2', endX + (Math.random() - 0.5) * 8)
                .attr('y2', endY + (Math.random() - 0.5) * 8)
                .attr('stroke', Math.random() < 0.5 ? '#ffd700' : '#ff2a5f')
                .attr('stroke-width', '0.7px')
                .attr('opacity', 0.9);

            bullet.transition()
                .duration(160)
                .style('opacity', 0)
                .remove();
        }

        // CONQUER COUNTRY AND RECOLOR TERRITORY
        function conquerCountry(attackerId, defenderId) {
            const attackerColor = countryBlocColors[attackerId];
            countryBlocColors[defenderId] = attackerColor;
            countryArmies[defenderId] = 30; // Resets conquered land force
            countryOccupation[defenderId] = 0;

            occupationLayer.select(`#occ-zone-${defenderId}`).remove();

            d3.select(`#country-${defenderId}`)
                .transition().duration(150).attr('fill', '#ffffff')
                .transition().duration(300).attr('fill', attackerColor);

            const aName = getCountryDisplayName(attackerId);
            const dName = getCountryDisplayName(defenderId);

            updateTickerLog(`[DOMÍNIO COMPLETO! 🚩] ${aName} conquistou 100% do território de ${dName}!`);

            try {
                if (synthAudio) synthAudio.triggerAttackRelease("E5", "8n");
            } catch(e) {}
        }

        // MAP NAVIGATION
        function zoomInMap() { svg.transition().duration(200).call(zoom.scaleBy, 1.4); }
        function zoomOutMap() { svg.transition().duration(200).call(zoom.scaleBy, 0.7); }
        function resetZoomMap() { svg.transition().duration(350).call(zoom.transform, d3.zoomIdentity); }

        function updateTickerLog(msg) {
            document.getElementById('live-war-ticker').innerText = msg;
        }
    </script>
</body>
</html>
